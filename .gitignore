# Gradle
.gradle/
build/
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
captures/
.cxx/

# Signing material never belongs in the repository
keystore.properties
*.jks
*.keystore

# JVM crash dumps. Gradle drops these in whatever directory it died in, and
# they are tens of thousands of lines of machine-local paths and heap state.
hs_err_pid*.log
replay_pid*.log

# The workbench: briefs, running notes and the long-form source material the
# docs are distilled from. Kept locally on purpose - what belongs to a reader
# lives in docs/ in a form meant to be read rather than followed.
#
# One directory rather than four loose files in the root, so the root holds only
# what a visitor expects to find there.
/workbench/

# Source artwork dropped in for conversion; the drawable is what ships.
/*.png
/art/

# OS noise
.DS_Store
Thumbs.db
