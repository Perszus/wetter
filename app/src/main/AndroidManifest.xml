<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET is the only permission Wetter holds, and it is used for exactly one
      thing: asking a weather provider about a place. There is no account, no
      analytics endpoint and no backend of ours to talk to (philos.md §16).

      ACCESS_COARSE_LOCATION arrives with optional current-location support and
      will stay optional — the app is fully usable without it. See docs/decisions.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Coarse location only, and optional.

      Asked for once, at the moment somebody presses "use my current location"
      on the map, and used for a single fix that is thrown away as soon as the
      pin is placed. Nothing subscribes to updates and nothing runs in the
      background: the app has no use for where you are except at the instant you
      ask it to put a pin there.

      Coarse rather than fine because the question is which town this is, not
      which side of the street - the finest model in the app resolves about two
      and a half kilometres, so a street-level fix would be precision the
      forecast cannot spend. required="false" so a device without the hardware
      can still install it; the button simply reports that it found nothing.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The background clock (work/Heartbeat.kt).

      Alarms are wiped by a reboot and by an app update, and an app that waits to
      be opened before it starts its clock again shows yesterday's rain on the
      home screen all morning. RECEIVE_BOOT_COMPLETED is what restarts it.

      SCHEDULE_EXACT_ALARM lets the wake land on the minute a radar sweep is
      published rather than somewhere in the few minutes after. From Android 12
      it is not granted by default; somebody turns it on in Settings, and the
      app's own settings panel offers the way there. Without it the clock still
      runs, inexactly - minutes late, never missing.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Severe weather warnings, and nothing else.

      The only thing this app says without being opened. What reaches a
      notification has already cleared the thresholds in domain/hazard - a gale,
      torrential rain, heavy snow, ice, a thunderstorm, or a temperature that is
      dangerous - so this is not a channel for showers, tips or news about the
      app. There is a switch for it in Settings and it can be turned off there
      without the app losing anything else.

      Asked for at the moment the app has a place to warn about, not on first
      launch: a permission prompt before the app has done anything is a prompt
      about nothing.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WetterApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wetter">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Wetter"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The home-screen widget.

          Exported because two of the three actions below are implicit
          broadcasts, and an unexported receiver never sees those. All three are
          protected broadcasts that only the system may send. The fourth thing it
          hears is its own redraw alarm (widget/Tick.kt), addressed to it by
          class. Being reachable costs nothing: the worst another app can do by
          naming this receiver explicitly is ask it to redraw itself.
        -->
        <receiver
            android:name=".work.HeartbeatReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.RainWidget"
            android:exported="true"
            android:label="@string/widget_rain_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rain_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NowWidget"
            android:exported="true"
            android:label="@string/widget_now_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.HoursWidget"
            android:exported="true"
            android:label="@string/widget_hours_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hours_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WeekWidget"
            android:exported="true"
            android:label="@string/widget_week_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.OverviewWidget"
            android:exported="true"
            android:label="@string/widget_overview_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/overview_widget_info" />
        </receiver>
    </application>
</manifest>
