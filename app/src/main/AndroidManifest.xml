<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET is the only permission Wetter holds, and it is used for exactly one
      thing: asking a weather provider about a place. There is no account, no
      analytics endpoint and no backend of ours to talk to (philos.md §16).

      ACCESS_COARSE_LOCATION arrives with optional current-location support and
      will stay optional — the app is fully usable without it. See docs/decisions.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Coarse location only, and optional.

      Asked for once, at the moment somebody presses "use my current location"
      on the map, and used for a single fix that is thrown away as soon as the
      pin is placed. Nothing subscribes to updates and nothing runs in the
      background: the app has no use for where you are except at the instant you
      ask it to put a pin there.

      Coarse rather than fine because the question is which town this is, not
      which side of the street - the finest model in the app resolves about two
      and a half kilometres, so a street-level fix would be precision the
      forecast cannot spend. required="false" so a device without the hardware
      can still install it; the button simply reports that it found nothing.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Severe weather warnings, and nothing else.

      The only thing this app says without being opened. What reaches a
      notification has already cleared the thresholds in domain/hazard - a gale,
      torrential rain, heavy snow, ice, a thunderstorm, or a temperature that is
      dangerous - so this is not a channel for showers, tips or news about the
      app. There is a switch for it in Settings and it can be turned off there
      without the app losing anything else.

      Asked for at the moment the app has a place to warn about, not on first
      launch: a permission prompt before the app has done anything is a prompt
      about nothing.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WetterApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wetter">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Wetter"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The home-screen widget.

          Exported because two of the three actions below are implicit
          broadcasts, and an unexported receiver never sees those. All three are
          protected broadcasts that only the system may send, so being reachable
          costs nothing: the worst another app can do by naming this receiver
          explicitly is ask it to redraw itself.
        -->
        <receiver
            android:name=".widget.RainWidget"
            android:exported="true"
            android:label="@string/widget_rain_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rain_widget_info" />
        </receiver>
    </application>
</manifest>
