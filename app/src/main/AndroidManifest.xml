<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET is the only permission Wetter holds, and it is used for exactly one
      thing: asking a weather provider about a place. There is no account, no
      analytics endpoint and no backend of ours to talk to (philos.md §16).

      ACCESS_COARSE_LOCATION arrives with optional current-location support and
      will stay optional — the app is fully usable without it. See docs/decisions.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".WetterApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wetter">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Wetter"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The home-screen widget.

          Exported because two of the three actions below are implicit
          broadcasts, and an unexported receiver never sees those. All three are
          protected broadcasts that only the system may send, so being reachable
          costs nothing: the worst another app can do by naming this receiver
          explicitly is ask it to redraw itself.
        -->
        <receiver
            android:name=".widget.RainWidget"
            android:exported="true"
            android:label="@string/widget_rain_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rain_widget_info" />
        </receiver>
    </application>
</manifest>
