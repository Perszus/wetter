<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Asking the weather services about a place. There is no backend of ours. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Optional, coarse location: one fix when somebody asks the map for their
      current location, never watched and never in the background. Coarse because
      no forecast grid resolves finer. The hardware is not required.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The background clock (work/Heartbeat.kt). A reboot or an update wipes its
      alarm, so boot restarts it. Exact alarms land the wake on a new radar sweep;
      from Android 12 that is granted in Settings, and without it the clock runs
      a few minutes late.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Severe weather warnings and nothing else, switchable in Settings. Asked for
      once the app is showing a forecast, not on first launch.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WetterApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wetter">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Wetter"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Where the heartbeat's alarm lands, and where boot and updates re-arm it. -->
        <receiver
            android:name=".work.HeartbeatReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          The widgets. Exported because the time and time-zone changes are
          implicit broadcasts, which an unexported receiver never sees; all are
          protected broadcasts only the system may send.
        -->
        <receiver
            android:name=".widget.RainWidget"
            android:exported="true"
            android:label="@string/widget_rain_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rain_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NowWidget"
            android:exported="true"
            android:label="@string/widget_now_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.HoursWidget"
            android:exported="true"
            android:label="@string/widget_hours_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hours_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WeekWidget"
            android:exported="true"
            android:label="@string/widget_week_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.OverviewWidget"
            android:exported="true"
            android:label="@string/widget_overview_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/overview_widget_info" />
        </receiver>
    </application>
</manifest>
