<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole widget is one image and four labels.

  The image carries the plate, the wind and the curve, because RemoteViews has
  no way to draw an arbitrary shape and a bitmap is the only door. The labels
  stay real TextViews so they follow the reader's font size, which an upscaled
  bitmap of type would not.

  Four cells of equal weight put each label at its own hour: with the chart
  spanning the full width, label n starts at n quarters across.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_rain_description"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_hour_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_hour_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_hour_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_hour_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
