    <!-- About -->
    <string name="about_version">Version %1$s</string>
    <string name="about_licence">GNU General Public License v3.0 or later</string>
    <string name="about_purpose">Wetter answers the question a weather app is opened for: is it going to rain, when, how hard, and when will it stop. It has no account and no tracking, and no server of its own. Your phone asks the weather services directly, for the place you are looking at and nothing else.</string>
    <string name="about_feature_rain">Rain, minute by minute</string>
    <string name="about_feature_rain_gloss">radar for the next two hours, the forecast after it</string>
    <string name="about_feature_source">The best forecast for where you are</string>
    <string name="about_feature_source_gloss">a regional model where one runs, a global one everywhere else</string>
    <string name="about_feature_warnings">Warnings only when it matters</string>
    <string name="about_feature_warnings_gloss">gales, torrential rain, ice, heavy snow and dangerous temperatures</string>
    <string name="about_feature_offline">Works offline</string>
    <string name="about_feature_offline_gloss">the last forecast stays on screen, with its age</string>
    <string name="about_feature_widgets">Five widgets</string>
    <string name="about_feature_widgets_gloss">the rain, the weather now, the hours, the week, and all of them together</string>
    <string name="about_links">Links</string>
    <string name="about_source_code">Source code</string>
    <string name="about_made_by">Designed and created by Roberts Kains</string>
    <string name="about_copyright">© Bolwarra Technologies</string>
    <string name="about_sources_detail">Wetter picks whichever of these suits the place you are looking at. It has no server of its own and asks these services directly.</string>

