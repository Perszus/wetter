<?xml version="1.0" encoding="utf-8"?>
<!--
  Four cells across, one down. Wider shows more days, up to the week; taller
  gives each day its range as a bar (widget/WeekWidget.kt), up to the height
  where the bars still read as a week rather than as columns.

  minWidth and minHeight use the 70n - 30 dp cell formula for older launchers;
  targetCellWidth and targetCellHeight say the same for Android 12 and later.
  The half-hour update is a backstop; the heartbeat redraws at each radar sweep.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_week_description"
    android:initialLayout="@layout/widget_picture"
    android:maxResizeHeight="240dp"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/widget_preview_week"
    android:previewLayout="@layout/widget_preview_week"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
