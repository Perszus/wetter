<?xml version="1.0" encoding="utf-8"?>
<!--
  Wetter opts out of both cloud backup and device-to-device transfer.

  allowBackup="false" already covers this, but from Android 12 that attribute is
  deprecated and these rules are what the platform actually reads. Everything is
  excluded rather than selectively filtered: the app holds a location list and a
  cached forecast, both of which are trivially rebuilt and neither of which
  should leave the device (philos.md §16).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
