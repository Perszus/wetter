<?xml version="1.0" encoding="utf-8"?>
<!--
  Three cells across, one down.

  minWidth and minHeight are the old way of saying that and still the only way
  older launchers hear it: the grid formula is 70n - 30, so three columns is
  180dp and one row is 40dp. targetCellWidth and targetCellHeight say the same
  thing in cells for Android 12 and later, which places widgets by grid rather
  than by guessing from dp.

  One row is about 56dp of real height on a phone, which is why the chart's
  insets are proportions rather than fixed dp and the hour labels shrink a step.

  updatePeriodMillis is the system floor of thirty minutes, and it is a backstop
  rather than the plan. The forecast refresh calls RainWidget.refresh whenever it
  runs, which is the update that matters because it has new data in hand.

  But that refresh is a WorkManager job, and WorkManager is the first thing an
  aggressive OEM battery manager stops - on some phones the app has to be granted
  autostart by hand before background work runs at all. This alarm belongs to the
  system, not to us: it starts the process to deliver it even after the app has
  been force-stopped, so the widget keeps up with the clock even where our own
  job never runs.

  It costs a wake-up every half hour, deferred while the device dozes. That is
  the price of a widget that is right when somebody looks at it, and the redraw
  itself is a cache read.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_rain_description"
    android:initialLayout="@layout/widget_rain"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="180dp"
    android:minWidth="180dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_rain"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
