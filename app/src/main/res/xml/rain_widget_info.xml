<?xml version="1.0" encoding="utf-8"?>
<!--
  Three cells across, one down.

  minWidth and minHeight are the old way of saying that and still the only way
  older launchers hear it: the grid formula is 70n - 30, so three columns is
  180dp and one row is 40dp. targetCellWidth and targetCellHeight say the same
  thing in cells for Android 12 and later, which places widgets by grid rather
  than by guessing from dp.

  One row is about 56dp of real height on a phone, which is why the chart's
  insets are proportions rather than fixed dp and the hour labels shrink a step.

  updatePeriodMillis is the system floor of thirty minutes, and it is a backstop
  rather than the plan. The plan is the heartbeat (work/Heartbeat.kt): an alarm
  timed to the radar that redraws the widget at every wake and again the moment a
  pass lands new data. This update belongs to the system instead, and it starts
  the process even where an aggressive OEM battery manager has stopped everything
  of ours - so the widget is redrawn from disk, and the heartbeat re-armed, even
  then. The redraw itself is a cache read; it never waits on the network.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_rain_description"
    android:initialLayout="@layout/widget_picture"
    android:minHeight="40dp"
    android:maxResizeHeight="200dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="180dp"
    android:minWidth="180dp"
    android:previewImage="@drawable/widget_preview_rain"
    android:previewLayout="@layout/widget_preview_rain"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
