<?xml version="1.0" encoding="utf-8"?>
<!--
  Three cells across, one down.

  minWidth and minHeight use the 70n - 30 dp cell formula for older launchers;
  targetCellWidth and targetCellHeight say the same for Android 12 and later.

  updatePeriodMillis, the system's thirty-minute floor, is a backstop to the
  heartbeat (work/Heartbeat.kt), which redraws at each radar sweep. It still
  starts the process where a battery manager has stopped everything else, so the
  widget is redrawn from disk and the heartbeat re-armed even then.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_rain_description"
    android:initialLayout="@layout/widget_picture"
    android:minHeight="40dp"
    android:maxResizeHeight="200dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="180dp"
    android:minWidth="180dp"
    android:previewImage="@drawable/widget_preview_rain"
    android:previewLayout="@layout/widget_preview_rain"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
