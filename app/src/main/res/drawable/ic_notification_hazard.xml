<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar mark for a severe-weather warning.

  A single flat silhouette on transparency, because that is the only thing
  Android will render here: the system takes the alpha channel and paints it in
  its own colour, so any fill of ours is discarded and any hole in the shape
  becomes a hole in the icon. Hence a solid triangle with the bar and dot cut
  out of it rather than drawn on top - the cut-outs are what make it read as a
  warning sign once the whole thing is one colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,2.4L23.1,21.6L0.9,21.6L12,2.4ZM11,9.2L11,15.2L13,15.2L13,9.2L11,9.2ZM11,17.2L11,19.2L13,19.2L13,17.2L11,17.2Z" />
</vector>
